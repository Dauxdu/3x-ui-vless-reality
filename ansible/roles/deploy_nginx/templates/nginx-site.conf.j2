server {
    listen 80;
    server_name {{ deploy_nginx_domain }};
    root {{ deploy_nginx_webroot }};
    index index.html;
}

server {
    listen 127.0.0.1:8443 ssl http2;
    server_name {{ deploy_nginx_domain }};
    root {{ deploy_nginx_webroot }};
    index index.html;

    ssl_certificate /etc/letsencrypt/live/{{ deploy_nginx_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ deploy_nginx_domain }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
}
