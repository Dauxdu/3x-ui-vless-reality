---
# Скопируйте в inventory/hosts.yml.
# Первый прогон: ansible_port: 22, ansible_user: root.
# После ssh_hardening смените на свой порт и пользователя.
all:
  children:
    inode:
      hosts:
        inode1:
          ansible_host: kvn.example.com
          ansible_user: root
          ansible_port: 22
    onode:
      hosts:
        onode1:
          ansible_host: site.example.com
          ansible_user: root
          ansible_port: 22
